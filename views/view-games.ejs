<section class="mt-4">
  <% if (typeof flash !== 'undefined' && flash) { %>
    <div class="alert alert-success alert-retro alert-dismissible fade show rounded-0 font-text mb-4" role="alert">
      <%= flash %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>
  <div class="d-flex justify-content-between align-items-center">
    <h1 class="fw-bold font-display retro-heading">GAME CATALOG</h1>
  </div>
  <hr class="border opacity-100">
  <div class="mt-4 p-4 retro-card rounded-0">
    <% if (!games || games.length === 0) { %>
      <div class="text-center py-5">
        <p class="fs-5 mb-0 font-text text-body-secondary">No games in the catalog.</p>
        <a href="/add-game" class="btn btn-primary rounded-0 mt-3">Add the first one</a>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover table-striped align-middle font-text mb-0">
          <thead class="table-dark">
            <tr>
              <th scope="col" class="text-nowrap">Image</th>
              <th scope="col">Title</th>
              <th scope="col" class="text-nowrap">Platform</th>
              <th scope="col">Description</th>
              <th scope="col" class="text-nowrap">Genre</th>
              <th scope="col" class="text-nowrap">Status</th>
              <th scope="col" class="text-center text-nowrap">User ID</th>
              <th scope="col" class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% games.forEach((game) => { %>
              <tr>
                <td class="games-table__thumb">
                  <% if (game.imagen) { %>
                    <img src="<%= game.imagen.indexOf('user-uploads/') === 0 ? '/' + game.imagen : '/images/' + game.imagen %>" alt="<%= game.titulo || game.nombre %>" class="games-table__img rounded-0" />
                  <% } else { %>
                    <span class="games-table__placeholder rounded-0 d-inline-flex align-items-center justify-content-center small">No image</span>
                  <% } %>
                </td>
                <td class="fw-semibold"><%= game.titulo || game.nombre %></td>
                <td><%= game.plataforma || '—' %></td>
                <td class="games-table__desc text-body-secondary" title="<%= game.descripcion || '' %>"><%= game.descripcion || '—' %></td>
                <td>
                  <% if (game.genero) { %>
                    <span class="badge bg-secondary rounded-0"><%= game.genero %></span>
                  <% } else { %>
                    <span class="small text-body-secondary">—</span>
                  <% } %>
                </td>
                <td>
                  <% if (game.completado === 1) { %>
                    <span class="badge bg-success rounded-0 text-white">Completed</span>
                  <% } else { %>
                    <span class="badge bg-warning text-dark rounded-0">In progress</span>
                  <% } %>
                </td>
                <td class="text-center"><%= game.id_usuario %></td>
                <td class="text-end">
                  <a href="/my-collection/<%= game.id %>/edit" class="btn btn-sm btn-outline-primary rounded-0 me-1">Edit</a>
                  <form method="post" action="/my-collection/<%= game.id %>/delete" class="d-inline" onsubmit="return confirm('Delete this game from the database?');">
                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-0">Delete</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</section>
