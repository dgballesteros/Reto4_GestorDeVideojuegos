<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GameCenter - Your video game manager</title>
  <script>
    (function() {
      var t = localStorage.getItem('gamecenter-theme');
      document.documentElement.setAttribute('data-bs-theme', (t === 'light' || t === 'dark') ? t : 'dark');
    })();
  </script>

  <!-- Estilos y Bootstrap-->
  <link rel='stylesheet' href='/stylesheets/style.css' />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  <link rel='stylesheet' href='/stylesheets/theme.css' />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&display=swap" rel="stylesheet">
</head>

<body class="d-flex flex-column min-vh-100">
  <header class="d-flex justify-content-between align-items-center py-4 w-100 layout-px">
    <h1 class="fs-5 font-display m-0 p-0 retro-heading">GAMECENTER</h1>
    <nav class="d-flex gap-3 gap-md-5">
      <a href="/" class="text-decoration-none fw-semibold font-text">Home</a>
      <% if (typeof session !== 'undefined' && session && session.user && session.user.email === 'admin') { %>
        <a href="/admin" class="text-decoration-none fw-semibold font-text">Manage Website</a>
      <% } else { %>
        <a href="/my-collection" class="text-decoration-none fw-semibold font-text">My Collection</a>
      <% } %>
      <a href="/about-us" class="text-decoration-none fw-semibold font-text">About</a>
      <% if (typeof session !== 'undefined' && session && session.user) { %>
        <a href="/add-game" class="text-decoration-none fw-semibold font-text">Add Game</a>
      <% } %>
    </nav>
    <div class="d-flex gap-3">
      <a href="#" class="text-decoration-none d-inline-flex align-items-center" id="color-mode" title="Toggle theme">
        <svg id="theme-icon-moon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.389 5.389 0 0 1-4.4 2.26 5.403 5.403 0 0 1-5.4-5.4 5.389 5.389 0 0 1 2.26-4.4C12.92 3.04 12.46 3 12 3z"/></svg>
        <svg id="theme-icon-sun" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 17.01c2.76 0 5.01-2.25 5.01-5.01S14.76 6.99 12 6.99 6.99 9.24 6.99 12s2.25 5.01 5.01 5.01M12 9c1.66 0 3.01 1.35 3.01 3.01s-1.35 3.01-3.01 3.01-3.01-1.35-3.01-3.01S10.34 9 12 9m1 10h-2v3h2zm0-17h-2v3h2zM2 11h3v2H2zm17 0h3v2h-3zM4.22 18.36l.71.71.71.71 1.06-1.06 1.06-1.06-.71-.71-.71-.71-1.06 1.06zM19.78 5.64l-.71-.71-.71-.71-1.06 1.06-1.06 1.06.71.71.71.71 1.06-1.06zm-12.02.7L6.7 5.28 5.64 4.22l-.71.71-.71.71L5.28 6.7l1.06 1.06.71-.71zm8.48 11.32 1.06 1.06 1.06 1.06.71-.71.71-.71-1.06-1.06-1.06-1.06-.71.71z"/></svg>
      </a>
      <% if (typeof session !== 'undefined' && session && session.user) { %>
        <a href="/logout" class="text-decoration-none fw-semibold font-text" title="Log out">Log out</a>
      <% } else { %>
        <a href="/login" class="text-decoration-none fw-semibold font-text d-inline-flex align-items-center gap-1" title="Log in">Log in</a>
      <% } %>
    </div>
  </header>
  <main class="flex-grow-1 layout-px">
    <%- body %>
  </main>
  <footer class="text-center py-4 font-text fw-semibold text-body-secondary">
    <p class="m-0 p-0 font-text">&copy Created by Daniel García - 2026</p>
  </footer>
</body>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
  integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
<script src="/javascripts/javascript.js"></script>
</html>