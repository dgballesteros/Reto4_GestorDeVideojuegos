<section class="mt-4">
  <% if (typeof flash !== 'undefined' && flash) { %>
    <div class="alert alert-success alert-retro alert-dismissible fade show rounded-0 font-text mb-4" role="alert">
      <%= flash %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>
  <div class="retro-card rounded-0 p-5 font-text text-center">
    <h1 class="fw-bold font-display retro-heading mb-4">WELCOME TO GAMECENTER</h1>
    <p class="fs-5 text-body-secondary mb-4 mx-auto" style="max-width: 32rem;">
      Manage your video game collection in one place. Add games, track which ones you've completed, and filter by platform, genre or status.
    </p>
    <hr class="my-4 opacity-25">
    <% if (typeof session !== 'undefined' && session && session.user) { %>
      <a href="/my-collection" class="btn btn-primary rounded-0 py-3 px-5 fw-semibold">Go to My Collection</a>
    <% } else { %>
      <a href="/login" class="btn btn-primary rounded-0 py-3 px-5 fw-semibold me-2">Log in</a>
      <a href="/register" class="btn btn-outline-primary rounded-0 py-3 px-5 fw-semibold">Register</a>
    <% } %>
  </div>
</section>
