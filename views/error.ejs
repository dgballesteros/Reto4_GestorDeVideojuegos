<section class="mt-4 retro-card rounded-0 p-4 mw-form-lg">
  <h1 class="font-display fs-6 mb-3 text-danger">ERROR</h1>
  <h2 class="font-text fs-5 fw-semibold mb-3"><%= typeof message !== 'undefined' ? message : 'Something went wrong' %></h2>
  <% if (typeof error !== 'undefined' && error && error.status) { %>
    <p class="font-text mb-2 text-body-secondary">Status: <%= error.status %></p>
  <% } %>
  <% if (typeof error !== 'undefined' && error && error.stack) { %>
    <pre class="font-text small mt-3 p-3 retro-box-dashed rounded-0 overflow-auto text-body-secondary max-h-pre"><%= error.stack %></pre>
  <% } %>
  <a href="/" class="btn btn-primary rounded-0 mt-3">Back to home</a>
</section>
