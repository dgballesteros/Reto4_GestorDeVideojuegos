<section class="mt-4 d-flex flex-column align-items-center">
  <div class="w-100 mw-form">
    <h1 class="fw-bold font-display text-center mb-1 retro-heading">ADD GAME</h1>
    <p class="font-text text-center mb-4 text-body-secondary small">Add a new game to your collection</p>
  </div>
  <hr class="border opacity-100 w-100 mw-form">
  <form method="post" action="/add-game" enctype="multipart/form-data" class="retro-card rounded-3 p-4 p-md-5 mt-4 font-text w-100 mw-form" data-ajax="true">
    <div id="ajax-message"></div>
    <div class="mb-3">
      <label for="nombre" class="form-label">Game name</label>
      <input type="text" class="form-control rounded-3" id="nombre" name="nombre" placeholder="e.g. The Legend of Zelda" required>
    </div>
    <div class="mb-3">
      <label for="descripcion" class="form-label">Description</label>
      <textarea class="form-control rounded-3" id="descripcion" name="descripcion" rows="3" placeholder="Brief description of the game..." required></textarea>
    </div>
    <div class="mb-3">
      <label for="plataforma" class="form-label">Platform</label>
      <input type="text" class="form-control rounded-3" id="plataforma" name="plataforma" placeholder="e.g. PC, PlayStation, Xbox, Switch...">
    </div>
    <div class="mb-3">
      <label for="genero" class="form-label">Genre</label>
      <input type="text" class="form-control rounded-3" id="genero" name="genero" placeholder="e.g. Adventure, RPG, Shooter...">
    </div>
    <div class="mb-3">
      <label for="estado" class="form-label">Status</label>
      <select class="form-select rounded-3" id="estado" name="estado">
        <option value="0">In progress</option>
        <option value="1">Completed</option>
      </select>
    </div>
    <div class="mb-3">
      <label for="imagen" class="form-label">Image</label>
      <input type="file" class="form-control rounded-3" id="imagen" name="imagen" accept="image/*">
    </div>
    <button type="submit" class="btn btn-primary rounded-3 w-100 py-2 fw-semibold mt-2">Add game</button>
    <hr class="my-4 opacity-25">
    <p class="text-center mb-0 text-body-secondary small">
      View your collection? <a href="/my-collection" class="fw-semibold text-decoration-none">My collection</a>
    </p>
  </form>
</section>
